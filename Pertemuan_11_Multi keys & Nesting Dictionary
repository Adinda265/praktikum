# #Program 11.1 Multi keys & Nesting Dictionary
import datetime

mahasiswa1={
     "nama":"budi antasari",
     "nim":"2023001",
     "sks lulus":"125",
     "beasiswa":"False",
     "lahir":"datetime.datetime(2003,7,21)"
 }
mahasiswa2={
     "nama":"susan widyawati",
     "nim":"2023002",
     "sks lulus":"115",
     "beasiswa":"True",
     "lahir":"datetime.datetime(2000,4,28)"
 }
mahasiswa3={
     "nama":"sakti mahardika",
     "nim":"2023003",
     "sks lulus":"130",
     "beasiswa":"True",
     "lahir":"datetime.datetime(2005,9,29)"
 }
data_mahasiswa={
     "MAHOO1":mahasiswa1,
     "MAH002":mahasiswa2,
     "MAH003":mahasiswa3
 }
print(f"{"KEY":<10} {"nama":<20} {"nim":<10} {"sks lulus":<5} {"beasiswa":<10} {"lahir":<10}")
print("-"*90)

for mahasiswa in data_mahasiswa:
     KEY=mahasiswa

     NAMA=data_mahasiswa[KEY]["nama"]
     NIM=data_mahasiswa[KEY]["nim"]
     SKS=data_mahasiswa[KEY]["sks lulus"]
     BEASISWA=data_mahasiswa[KEY]["beasiswa"]
     LAHIR=data_mahasiswa[KEY]["lahir"]
     print(f"{KEY:<10} {"nama":<20} {"sks_lulus":<5} {"beasiswa":<10} {"lahir"}")

