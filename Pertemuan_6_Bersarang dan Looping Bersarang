nominal_tarik = 650000
if status_akun == "aktif":
    if nominal_tarik<= saldo:
        if nominal_tarik >=650000:
            saldo = saldo - nominal_tarik
            print(f"penarikan berhasil: Rp{nominal_tarik:,}")
