#4.list awal sesuai soal
data_barang = [["buku",5000],["pensil",2000],["pengaris",3000]]

#a.tampilkan harga dari "pensil" dengan memangil indeks spesifik
harga_pensil = data_barang[1][1]
print(f"harga dari pensil adalah = {harga_pensil}")
print("menampilka  semua data mengunakan perulangan:")
#b.gunakan perulangan untuk menampilkan data pada format yang diminta
