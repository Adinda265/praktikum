#1.membuat list awal 
kendaraan = ["motor","mobil","sepeda","bus"]
print("list_awal:", kendaraan)

#a. tambahkan truk diakhir list
kendaraan.append("truk")
print(f"kendaraan ditambah lagi = {kendaraan}")

#b.sisipkan becak di index 1
kendaraan.insert(1,"becak")
print(f"kendaraan_disisip becak = {kendaraan}")

#c.hapus data yang berada paling belakang 
kendaraan.pop()
print(f"kendaraan_akhir = {kendaraan}")

#d.ubah elemen sepeda menjadi skuter
kendaraan[2] = "skuter"
print(f"kendaraan dirubah = {kendaraan}")

#e.tampilkan informasi jumlah total data 
total_data = len(kendaraan)
print(f"jumlah total data sekarang:", total_data)


#2.list awal sesuai soal
angka = [75,80,90,75,85,100,65]
print("list awal:", angka)

#a.cari tahu index ke berapa skor 100 berada
index_100 = angka.index(100)
print(f"skor 100 berada diindex ke:, {index_100}")

#b.hitung ada berapa banyak siswa yang mendapat skor 75
jumlah_75 = angka.count(75)
print(f"jumlah siswa yang mendapat skor 75 = {jumlah_75}")

#c.urutkan list tersebut dari nilai terkecil ke terbesar
angka.sort()
print(f"list setelah diurutkan (terkecil ke terbesar) = {angka}")

#d. balikan urutan list tersebut menjadi dari terbesar ke terkecil
angka.reverse()
print(f"list setelah dibalik (terbesar ke terkecil) = {angka}")


