#3.  a. membuat dictionary bernama keranjang
keranjang = {"apel": 5000,"pisang": 3000,"jeruk":7000,"anggur": 15000}
#inisialisasi variabel untuk menyimpan total belanja 
total_belanja = 0

#    b.gunakan perulangan untuk menampilkan setiap barang dan harganya 
for buah,harga in keranjang.items():
    print(f"harga{buah}:Rp {harga}")

#    c.menambah harga buah kwtotal belanja disetiap peluang 
total_belanja += harga

#menampilkan hasil total belanja 
print(f"total belanja : Rp {total_belanja}")
